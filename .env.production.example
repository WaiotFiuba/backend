APP_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
MAP_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
MAP_DB_POOL_SIZE=5
MAP_DB_MAX_OVERFLOW=0
AUTO_CREATE_DB=false
AUTO_CREATE_MAP_DB=false
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Base de datos mapa
ENABLE_MAP_DB=true

# Simulador local apuntando a la API hosteada
SIMULATOR_BACKEND_URL=https://your-backend.onrender.com
SIMULATOR_POLL_SECONDS=2
SIMULATOR_BATCH_SIZE=500
SIMULATOR_CONTAINER_LIMIT=2000
SIMULATOR_CONTROL_MISS_TOLERANCE=5

# Promedios y parámetros usados por el simulador, análisis de densidad y seeds
PROMEDIO_GENERACION_BASURA_PERSONAS_24H=1.5
DENSIDAD_BASURA_KG_M3=150.0
DENSITY_STREET_BUFFER_M=18.0
DENSITY_MIN_DAILY_FILL_PCT_FLOOR=20.0
DENSITY_FALLBACK_DAILY_WASTE_KG=150.0
