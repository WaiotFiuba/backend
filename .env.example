APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# MySQL example:
# DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/waiot
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
MAP_DB_POOL_SIZE=5
MAP_DB_MAX_OVERFLOW=0
AUTO_CREATE_DB=true
AUTO_CREATE_MAP_DB=false
CORS_ALLOWED_ORIGINS=*
CITY_NAME=Buenos Aires

# Base de datos mapa (PostGIS local / Docker)
ENABLE_MAP_DB=false
POSTGRES_DB=waiot_map
POSTGRES_USER=waiot
POSTGRES_PASSWORD=waiot_passz
POSTGRES_PORT=5432
MAP_DATABASE_URL=postgresql+asyncpg://waiot:waiot_pass@postgis:5432/waiot_map

# Parámetros del simulador
SIMULATOR_BACKEND_URL=http://api:8000
SIMULATOR_POLL_SECONDS=2
SIMULATOR_BATCH_SIZE=30000
SIMULATOR_CONTAINER_LIMIT=
SIMULATOR_CONTROL_MISS_TOLERANCE=5

# Parámetros y promedios de densidad / generación de residuos
PROMEDIO_GENERACION_BASURA_PERSONAS_24H=1.5
DENSIDAD_BASURA_KG_M3=150.0
DENSITY_STREET_BUFFER_M=18.0
DENSITY_MIN_DAILY_FILL_PCT_FLOOR=20.0
DENSITY_FALLBACK_DAILY_WASTE_KG=150.0
