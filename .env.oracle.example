# Producción en la VM de Oracle (docker compose). Copiar a .env en
# /data/app/backend y reemplazar los secretos.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=map
API_DOMAIN=144-22-50-249.sslip.io

APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAP_DB_POOL_SIZE=5
MAP_DB_MAX_OVERFLOW=5
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CITY_NAME=Buenos Aires
DATA_LEVEL_RETENTION_PERIODS=1920

ENABLE_MAP_DB=true
POSTGRES_DB=waiotfiuba
POSTGRES_USER=waiotfiuba
POSTGRES_PASSWORD=replace-with-a-random-password
MAP_DATABASE_URL=postgresql+asyncpg://waiotfiuba:replace-with-a-random-password@postgis:5432/waiotfiuba

BACKEND_URL=http://api:8000
SIMULATOR_POLL_SECONDS=2
SIMULATOR_BATCH_SIZE=10000
SIMULATOR_CONTAINER_LIMIT=
SIMULATOR_CONTROL_MISS_TOLERANCE=5

PROMEDIO_GENERACION_BASURA_PERSONAS_24H=1.5
DENSIDAD_BASURA_KG_M3=150.0
DENSITY_STREET_BUFFER_M=18.0
DENSITY_MIN_DAILY_FILL_PCT_FLOOR=20.0
DENSITY_FALLBACK_DAILY_WASTE_KG=150.0
